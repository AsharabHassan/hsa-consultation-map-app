# ─────────────────────────────────────────────────────────────
# Harley Street Aesthetics — HSA Consultation Map
#
# Copy to .env.local and fill in. .env.local is gitignored; never commit it.
#   cp .env.local.example .env.local
#
# Covers every variable this app reads. Anything under "optional" has a
# working code default, shown in its comment — leave it unset to take that.
# ─────────────────────────────────────────────────────────────

# ── Required — the funnel cannot produce a report without these ──

# Anthropic — the written consultation assessment (Claude vision, /api/analyze)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI — the annotated consultation map (gpt-image-2 edits, /api/map).
# If generation fails, the report falls back to local pins over the photo.
OPENAI_API_KEY=sk-...


# ── Optional — shared clinic skin classifier (the trained 18-region face model) ──
# Same service the other Veluria clinic apps call. Leave ALL of these unset and
# the app is exactly Claude-led; the app never depends on the classifier.
# HTTPS base URL of the classifier (/predict is appended).
# LOCAL_CLASSIFIER_URL=
# Shared secret sent as X-Classifier-Key. Required when the URL is public.
# LOCAL_CLASSIFIER_SECRET=
# observe (default) = attach the classifier verdict to each pin only.
# lead = the classifier decides which regions appear; the vision model only
#        describes them (falls back to Claude-led when unavailable). off = never call.
# CLASSIFIER_MODE=observe


# ── CRM + report delivery (optional — flow completes without them) ──
# Leave ALL of these unset for local testing to avoid creating real contacts.

# GoHighLevel inbound webhook URL (Workflows -> Inbound Webhook trigger)
# Leads are POSTed here as JSON before results are revealed.
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/...

# --- GoHighLevel v2 API — capture the report PDF + email it (/api/report) ---
# Private Integration token (pit-...). NEVER commit the real value.
# This app accepts EITHER name; set one of the two.
GHL_API_TOKEN=
# GHL_API_KEY=
# GHL sub-account (location) id
GHL_LOCATION_ID=
# Contact custom-field KEY that stores the report's media URL (used to write it).
# Default: facial_report_pdf
GHL_REPORT_FIELD_KEY=facial_report_pdf
# Contact custom-field ID for the same field (used to read it back — GET returns
# customFields as {id, value} with no key). Find it once by writing the field via
# the API and reading the response, or in GHL's custom-field settings.
GHL_REPORT_FIELD_ID=
# Booking calendar link used in the report email's CTA button. Falls back to
# NEXT_PUBLIC_BOOKING_URL, then the HSA free-online-consultation widget.
GHL_BOOKING_URL=
# "From" address for the report email. Must be a verified sender/domain in GHL.
# If unset, GHL uses the location's default sending address.
GHL_EMAIL_FROM=
# Sender display name shown to recipients (defaults to "Harley Street Aesthetics").
GHL_EMAIL_FROM_NAME=
# Optional API base override. Default: https://services.leadconnectorhq.com
# GHL_API_BASE=https://services.leadconnectorhq.com


# ── Public URLs and tracking (NEXT_PUBLIC_* ship to the browser) ──

# Booking CTA on the results page. Falls back to NEXT_PUBLIC_BOOKING_URL, then
# the HSA free-online-consultation widget.
NEXT_PUBLIC_CALENDAR_URL=

# Shared fallback booking link for the page + email CTAs.
NEXT_PUBLIC_BOOKING_URL=

# Meta (Facebook) Pixel ID — used for PageView + Lead events and the
# Conversions API fields forwarded to GHL. Set the real HSA pixel before any
# real campaign; leave unset for demos.
NEXT_PUBLIC_META_PIXEL_ID=

# NOTE: this app does NOT read NEXT_PUBLIC_SITE_URL (some sibling forks do).
# Setting it here has no effect.
